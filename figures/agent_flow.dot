digraph G {
graph [bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.35", dpi=220];
node [fontname="Times New Roman", fontsize=16, color="#333333", penwidth=1.2,
      shape=box, margin="0.13,0.09"];
edge [fontname="Times New Roman", fontsize=13, color="#444444", arrowsize=0.7];

s [label="Получить состояние агента",shape=oval];
a [label="Есть состояние?",shape=diamond];
done [label="План завершён",shape=oval];
b [label="Полное состояние
уже встречалось?",shape=diamond];
stop [label="Остановить повтор
Вернуть μ и λ",shape=oval];
c [label="Сохранить состояние"];
lim [label="Достигнут лимит?",shape=diamond];
exit [label="Завершить по лимиту",shape=oval];
d [label="Выполнить одно действие
Обновить состояние"];
s -> a;a -> done [label="Нет"];a -> b [label="Да"];
b -> stop [label="Да"];b -> c [label="Нет"];
c -> lim;lim -> exit [label="Да"];lim -> d [label="Нет"];d -> a;
}