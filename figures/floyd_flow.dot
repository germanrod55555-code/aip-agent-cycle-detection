digraph G {
graph [bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.35", dpi=220];
node [fontname="Times New Roman", fontsize=16, color="#333333", penwidth=1.2,
      shape=box, margin="0.13,0.09"];
edge [fontname="Times New Roman", fontsize=13, color="#444444", arrowsize=0.7];

s [label="Начальное состояние s₀",shape=oval];
a [label="slow = f(s₀)
fast = f(f(s₀))"];
b [label="Достигнуто None?",shape=diamond];
t [label="Завершение",shape=oval];
c [label="slow = fast?",shape=diamond];
d [label="slow = f(slow)
fast = f(f(fast))"];
e [label="Вернуть slow в s₀
Оба указателя идут по одному шагу"];
f [label="Первая встреча даёт μ и вход"];
g [label="Обойти цикл от входа
Число переходов равно λ"];
h [label="Результат μ и λ",shape=oval];
s -> a -> b; b -> t [label="Да"]; b -> c [label="Нет"];
c -> d [label="Нет"];d -> b;
c -> e [label="Да"];e -> f -> g -> h;
}