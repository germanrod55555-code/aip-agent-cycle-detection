digraph G {
graph [bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.35", dpi=220];
node [fontname="Times New Roman", fontsize=16, color="#333333", penwidth=1.2,
      shape=box, margin="0.13,0.09"];
edge [fontname="Times New Roman", fontsize=13, color="#444444", arrowsize=0.7];

s [label="Пустая таблица
state = s₀; i = 0",shape=oval];
a [label="state = None?",shape=diamond];
t [label="Завершение",shape=oval];
b [label="state уже в таблице?",shape=diamond];
c [label="Получить первый индекс j
μ = j; λ = i − j",shape=box];
r [label="Цикл найден",shape=oval];
d [label="Сохранить state и индекс i"];
e [label="state = f(state)
i = i + 1"];
s -> a; a -> t [label="Да"];a -> b [label="Нет"];
b -> c [label="Да"];c -> r;
b -> d [label="Нет"];d -> e;e -> a;
}